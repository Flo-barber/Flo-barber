# Copie ce fichier en ".env.local" et renseigne tes clés.

# --- Supabase (Settings > API dans ton projet Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (clé "anon public")
# Clé "service_role" (Settings > API). SECRET — uniquement côté serveur.
# Nécessaire pour la suppression de compte (RGPD, droit à l'effacement).
# NE JAMAIS l'exposer au navigateur ni la commiter.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (clé "service_role" secrète)

# --- Mur d'authentification (site en développement) ---
# Définis ces variables pour protéger tout le site par un login/mot de passe.
# Laisse-les vides (ou supprime-les) pour ouvrir le site au public.
SITE_USER=flo
SITE_PASSWORD=choisis-un-mot-de-passe

# --- Boutique / paiement (Stripe) ---
# Dashboard Stripe > Developers > API keys (utilise les clés "test" pour commencer).
STRIPE_SECRET_KEY=sk_test_...
# Secret du endpoint webhook (Developers > Webhooks) — vérifie la signature.
STRIPE_WEBHOOK_SECRET=whsec_...
# URL publique du site (pour les URLs de retour Stripe). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://flo-barber.vercel.app
# (Optionnel) nom du bucket Storage des images produits (défaut : "products").
# NEXT_PUBLIC_STORAGE_BUCKET=products

# --- Google Wallet (Phase 2) ---
# Ton Issuer ID (Google Pay & Wallet Console)
GOOGLE_WALLET_ISSUER_ID=3388000000023174098
# Le fichier JSON du compte de service, encodé en base64 (voir GUIDE-FIDELITE.md)
GOOGLE_WALLET_SERVICE_ACCOUNT=eyJ0eXBlIjoic2Vy...
# (Optionnel) suffixe de la classe et URL du logo (PNG public, pas SVG)
# GOOGLE_WALLET_CLASS_SUFFIX=flo_barber_loyalty
# GOOGLE_WALLET_LOGO_URL=https://ton-domaine.vercel.app/icon-512.png
