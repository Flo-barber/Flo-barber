# Copie ce fichier en ".env.local" et renseigne tes clés.

# --- Supabase (Settings > API dans ton projet Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (clé "anon public")

# --- Google Wallet (Phase 2) ---
# Ton Issuer ID (Google Pay & Wallet Console)
GOOGLE_WALLET_ISSUER_ID=3388000000023174098
# Le fichier JSON du compte de service, encodé en base64 (voir GUIDE-FIDELITE.md)
GOOGLE_WALLET_SERVICE_ACCOUNT=eyJ0eXBlIjoic2Vy...
# (Optionnel) suffixe de la classe et URL du logo (PNG public, pas SVG)
# GOOGLE_WALLET_CLASS_SUFFIX=flo_barber_loyalty
# GOOGLE_WALLET_LOGO_URL=https://ton-domaine.vercel.app/icon-512.png
